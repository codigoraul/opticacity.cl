---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import '../styles/footer.css';
const base = import.meta.env.BASE_URL;
const videos = [
  { f: 'crizal-multi', t: 'Crizal: protección en cada mirada', d: 'Tratamiento antirreflejo que reduce reflejos y resiste rayones y manchas.' },
  { f: 'crizal-usuarios', t: 'Crizal: probado por usuarios', d: 'Así se ve la diferencia en el uso diario.' },
  { f: 'eyezen', t: 'Eyezen: para la vida frente a pantallas', d: 'Cristales pensados para reducir la fatiga visual en pantallas.' },
  { f: 'varilux-expression', t: 'Varilux: visión natural a toda distancia', d: 'Lentes progresivos para ver bien de lejos, intermedio y cerca.' },
];
const menu = [
  { t: 'Anteojos', s: ['Todos los anteojos', 'Mujer', 'Hombre', 'En oferta', 'Anteojos recientes'] },
  { t: 'Anteojos de sol', s: ['Todos', 'Mujer', 'Hombre', 'Graduados'] },
  { t: 'Tecnología', a: `${base}tecnologia/` },
  { t: 'Nosotros', a: `${base}nosotros/` },
  { t: 'Contacto', a: `${base}contacto/` },
];
---
<Base title="Tecnología en tus lentes · Óptica City">
<div id="app">
<div class="ann"><div class="wrap"><span>Atención visual con Tecnólogo Médico Optómetra · Lincoyan 368, Concepción</span><a href="https://wa.me/56941603654" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a><span class="ann-soc"><a href="https://www.instagram.com/opticacitycl/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a><a href="https://www.facebook.com/%C3%93ptica-City-107521397624082/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5A.5.5 0 0 1 14 8z"/></svg></a><a href="https://www.tiktok.com/@opticacity_cl" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.1 4.2 5 4.5"/></svg></a></span></div></div>

<header class="top">
  <div class="wrap">
    <a class="logo" href={base} aria-label="Óptica City, inicio"><img src={`${base}img/logo-opticacity.png`} alt="Óptica City" width="392" height="313"></a>
    <ul class="nav" id="nav">
      {menu.map((m) => m.a ? <li><a href={m.a}>{m.t}</a></li> : <li><button type="button" aria-haspopup="true">{m.t}</button><div class="panel">{m.s.map((x) => <a href={`${base}#productos`}>{x}</a>)}</div></li>)}
    </ul>
    <div class="tools">
      <button class="ib" type="button" aria-label="Buscar"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
      <button class="ib" type="button" aria-label="Mi cuenta"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg></button>
      <button class="ib" type="button" aria-label="Carrito"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span class="badge" id="badge" hidden>0</span></button>
      <button class="ib menu" id="menuBtn" type="button" aria-label="Abrir menú" aria-expanded="false"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
</header>

<main id="top">
  <section class="wrap tec" aria-label="Tecnología en tus lentes">
    <span class="label">Tecnología</span>
    <h1>Tecnología en tus lentes</h1>
    <p class="lead">Conoce los tratamientos y diseños de cristales que usamos en Óptica City para que veas mejor y cuides tus ojos.</p>
    <div class="vids">
      {videos.map((v) => (
        <article class="vid">
          <div class="vbox">
            <video controls preload="none" playsinline poster={`${base}videos/${v.f}.jpg`}>
              <source src={`${base}videos/${v.f}.mp4`} type="video/mp4" />
            </video>
          </div>
          <h2>{v.t}</h2>
          <p>{v.d}</p>
        </article>
      ))}
    </div>
    <div class="row">
      <a class="btn pink" href="https://wa.me/56941603654?text=Hola%2C%20quiero%20consultar%20por%20cristales" target="_blank" rel="noopener noreferrer">Consulta por tus cristales</a>
      <a class="btn line" href={`${base}#cristales`}>Ver cristales</a>
    </div>
  </section>
</main>

<footer class="site-foot">
  <div class="fcta"><div class="wrap fcta-in">
    <p>¿Necesitas ayuda con tu receta o tu pedido?</p>
    <a class="btn white" href="https://wa.me/56941603654" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
  </div></div>
  <div class="wrap">
    <div class="foot">
      <div class="fbrand">
        <img src={`${base}img/logo-opticacity-blanco.svg`} alt="Óptica City" width="120" height="108" loading="lazy" />
        <p>Atención visual con Tecnólogo Médico Optómetra, anteojos y cristales a tu medida en Concepción.</p>
        <div class="soc">
          <a href="https://www.instagram.com/opticacitycl/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
          <a href="https://www.facebook.com/%C3%93ptica-City-107521397624082/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5A.5.5 0 0 1 14 8z"/></svg></a><a href="https://www.tiktok.com/@opticacity_cl" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.1 4.2 5 4.5"/></svg></a>
          <a href="https://wa.me/56941603654" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 20l1.3-4.2A8 8 0 1 1 8.4 18.8z"/><path d="M9 9c0 3 3 6 6 6l1.2-1.6-2-1-1 .6c-.8-.4-1.600-1.200-2-2l.6-1-1-2z"/></svg></a>
        </div>
      </div>
      <div><h4>Tienda</h4><a href={`${base}#productos`}>Anteojos</a><a href={`${base}#cristales`}>Cristales</a><a href={`${base}#configurador`}>Arma tus anteojos</a><a href={`${base}nosotros/`}>Quiénes somos</a></div>
      <div><h4>Ayuda</h4><a href={`${base}#configurador`}>Cómo hacer tu pedido</a><a href={`${base}#configurador`}>Tu receta</a><a href={`${base}#configurador`}>Distancia pupilar (DP)</a><a href={`${base}#cristales`}>Tipos de cristales</a></div>
      <div id="contacto"><h4>Visítanos</h4><a href="https://maps.app.goo.gl/LR4JTUZteNK2hdDp6" target="_blank" rel="noopener noreferrer">Lincoyan 368</a><a href="https://maps.app.goo.gl/wWynYZmzBksEbEtL9" target="_blank" rel="noopener noreferrer">Barros Arana 449</a><a href="https://maps.app.goo.gl/LR4JTUZteNK2hdDp6" target="_blank" rel="noopener noreferrer">Concepción, Chile</a><a href="tel:+56941603654">+56 9 4160 3654</a><a href="https://wa.me/56941603654" target="_blank" rel="noopener noreferrer">WhatsApp</a></div>
    </div>
    <div class="legal"><span>© Óptica City. Todos los derechos reservados · Sitio diseñado por <a href="https://disenopaginas.cl" target="_blank" rel="noopener">diseñopaginas</a></span><span>Fotografías: <a href="https://www.freepik.com" target="_blank" rel="noopener noreferrer">Freepik</a></span></div>
  </div>
</footer>
</div>
<script>
  (function () {
    var $ = function (s) { return document.querySelector(s); };
    $('#nav').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; var o = b.parentElement.classList.toggle('open'); b.setAttribute('aria-expanded', o); });
    $('#menuBtn').onclick = function () { var o = $('#nav').classList.toggle('open'); this.setAttribute('aria-expanded', o); };
  })();
</script>
<script>
  const vids = document.querySelectorAll('.vbox video');
  vids.forEach((v) => {
    v.addEventListener('play', () => {
      vids.forEach((o) => { if (o !== v && !o.paused) o.pause(); });
    });
  });
</script>
</Base>
